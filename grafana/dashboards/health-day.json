    },
    {
      "datasource": {"type": "postgres", "uid": "apple-health-postgres"},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 30},
      "id": 7,
      "options": {"cellHeight": "sm", "showHeader": true},
      "targets": [{"format": "table", "rawQuery": true, "rawSql": "SELECT replace(metric,'_',' ') AS \"Metric\",unit AS \"Unit\",count(*) AS \"Samples\",round(sum(value)::numeric,2) AS \"Sum\",round(avg(value)::numeric,2) AS \"Average\",round(min(value)::numeric,2) AS \"Minimum\",round(max(value)::numeric,2) AS \"Maximum\" FROM health_metrics WHERE user_id='$user_id'::uuid AND $__timeFilter(time) GROUP BY metric,unit ORDER BY metric;", "refId": "A"}],
      "title": "Metric summary",
      "type": "table"
    },
    {
      "datasource": {"type": "postgres", "uid": "apple-health-postgres"},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 30},
      "id": 8,
      "options": {"cellHeight": "sm", "showHeader": true},
      "targets": [{"format": "table", "rawQuery": true, "rawSql": "SELECT start_time AT TIME ZONE '$timezone' AS \"Start\",replace(workout_type,'_',' ') AS \"Workout\",round((coalesce(duration_seconds,extract(epoch FROM end_time-start_time))/60)::numeric,1) AS \"Minutes\",round(active_energy_kcal::numeric) AS \"Active kcal\",round(distance_miles::numeric,2) AS \"Miles\",round(average_heart_rate_bpm::numeric) AS \"Avg HR\",CASE WHEN EXISTS (SELECT 1 FROM workout_routes r WHERE r.workout_id=w.id) THEN 'Yes' ELSE 'No' END AS \"Route\" FROM workouts w WHERE user_id='$user_id'::uuid AND $__timeFilter(start_time) ORDER BY start_time;", "refId": "A"}],
      "title": "Workouts",
      "type": "table"
    }
