    {
      "datasource": {"type": "postgres", "uid": "apple-health-postgres"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 14, "lineWidth": 2, "showPoints": "never"}, "unit": "kcal"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 6},
      "id": 4,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "single"}},
      "targets": [{"format": "time_series", "rawQuery": true, "rawSql": "WITH energy AS (SELECT time,sum(value) FILTER (WHERE metric='active_energy') AS active,sum(value) FILTER (WHERE metric='basal_energy_burned') AS basal FROM health_metrics WHERE user_id='$user_id'::uuid AND metric IN ('active_energy','basal_energy_burned') AND resolution='raw' AND $__timeFilter(time) GROUP BY time) SELECT time,sum(coalesce(active,0)) OVER (ORDER BY time ROWS UNBOUNDED PRECEDING) AS \"Cumulative active kcal\",sum(coalesce(basal,0)) OVER (ORDER BY time ROWS UNBOUNDED PRECEDING) AS \"Cumulative basal kcal\",sum(coalesce(active,0)+coalesce(basal,0)) OVER (ORDER BY time ROWS UNBOUNDED PRECEDING) AS \"Cumulative total kcal\" FROM energy ORDER BY time;", "refId": "A"}],
      "title": "Energy burned through the day",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "postgres", "uid": "apple-health-postgres"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "bars", "fillOpacity": 55, "lineWidth": 1, "showPoints": "never"}}, "overrides": [{"matcher": {"id": "byName", "options": "Steps"}, "properties": [{"id": "unit", "value": "locale"}]}, {"matcher": {"id": "byName", "options": "Active kcal"}, "properties": [{"id": "unit", "value": "kcal"}, {"id": "custom.axisPlacement", "value": "right"}]}]},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 22},
      "id": 5,
      "options": {"legend": {"calcs": ["sum"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"format": "time_series", "rawQuery": true, "rawSql": "SELECT time_bucket_gapfill('1 hour',time,timezone=>'$timezone') AS time,sum(value) FILTER (WHERE metric='step_count') AS \"Steps\",sum(value) FILTER (WHERE metric='active_energy') AS \"Active kcal\" FROM health_metrics WHERE user_id='$user_id'::uuid AND metric IN ('step_count','active_energy') AND resolution='raw' AND $__timeFilter(time) GROUP BY 1 ORDER BY 1;", "refId": "A"}],
      "title": "Hourly activity rhythm",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "postgres", "uid": "apple-health-postgres"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 5, "lineWidth": 2, "showPoints": "auto"}}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 22},
      "id": 6,
      "options": {"legend": {"calcs": ["mean", "min", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"format": "time_series", "rawQuery": true, "rawSql": "SELECT time,value,replace(metric,'_',' ') AS metric FROM health_metrics WHERE user_id='$user_id'::uuid AND metric IN ('respiratory_rate','blood_oxygen_saturation','heart_rate_variability','physical_effort','headphone_audio_exposure') AND $__timeFilter(time) ORDER BY time;", "refId": "A"}],
      "title": "Vitals, effort, and exposure timeline",
