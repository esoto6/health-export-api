POSTGRES_DB=health
POSTGRES_USER=health_app
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
GRAFANA_DB_PASSWORD=REPLACE_WITH_DIFFERENT_LONG_RANDOM_PASSWORD
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_ANOTHER_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql+psycopg://health_app:REPLACE_WITH_LONG_RANDOM_PASSWORD@timescaledb:5432/health
API_BIND=127.0.0.1
API_PORT=8000
GRAFANA_BIND=127.0.0.1
GRAFANA_PORT=3000
LOG_LEVEL=info
OTEL_SERVICE_NAME=apple-health-api
# Docker Compose overrides this with its private http://lgtm:4318 endpoint.
# Use this value when running the API directly on the host.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
DEPLOYMENT_ENVIRONMENT=development
ADMIN_API_TOKEN=replace_with_a_long_random_secret
